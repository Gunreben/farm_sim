<?xml version="1.0" encoding="UTF-8" ?>
<!--
  Fast DDS profile for the simulator's large messages (point clouds ~0.6 MB, images ~2.8 MB).

  Isaac Sim runs on its bundled Jazzy libs (Fast DDS 2.x) and the host on Lyrical (Fast DDS 3.x);
  the two cannot share memory, so everything goes over UDP loopback, where the 208 KB default socket
  buffers drop fragments of big messages. Use on BOTH sides:
      export FASTRTPS_DEFAULT_PROFILES_FILE=~/ros2_ws/src/farm_sim/config/fastdds_large_msgs.xml   # Fast DDS 2.x
      export FASTDDS_DEFAULT_PROFILES_FILE=~/ros2_ws/src/farm_sim/config/fastdds_large_msgs.xml    # Fast DDS 3.x
  Buffers are capped by net.core.rmem_max / wmem_max (4 MB on this machine).
-->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
    <transport_descriptors>
        <transport_descriptor>
            <transport_id>udp_large</transport_id>
            <type>UDPv4</type>
            <sendBufferSize>4194304</sendBufferSize>
            <receiveBufferSize>4194304</receiveBufferSize>
        </transport_descriptor>
    </transport_descriptors>
    <participant profile_name="farm_sim_participant" is_default_profile="true">
        <rtps>
            <userTransports>
                <transport_id>udp_large</transport_id>
            </userTransports>
            <useBuiltinTransports>false</useBuiltinTransports>
            <sendSocketBufferSize>4194304</sendSocketBufferSize>
            <listenSocketBufferSize>4194304</listenSocketBufferSize>
        </rtps>
    </participant>
</profiles>
